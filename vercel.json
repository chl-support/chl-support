{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/system?action=health"
    },
    {
      "source": "/api/bootstrap",
      "destination": "/api/system?action=bootstrap"
    },
    {
      "source": "/api/reset",
      "destination": "/api/system?action=reset"
    }
  ],
  "crons": [
    {
      "path": "/api/collection?action=reminder",
      "schedule": "0 1 * * *"
    }
  ]
}
