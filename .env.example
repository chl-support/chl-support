# ── Variabel lingkungan backend (set di Vercel → Project → Settings → Environment Variables)
# Salin ke .env.local untuk pengembangan lokal dengan `vercel dev`.

# Neon Postgres — TERISI OTOMATIS saat kamu hubungkan Neon dari Storage tab Vercel.
# Backend membaca yang mana pun yang tersedia (DATABASE_URL diprioritaskan).
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# POSTGRES_URL=...            # alias yang juga di-set integrasi Neon

# Vercel Blob — TERISI OTOMATIS saat kamu hubungkan Blob store dari Storage tab Vercel.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Anthropic (fitur AI) — SET MANUAL. Ambil dari https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# AI_MODEL=claude-sonnet-5   # opsional, default sudah claude-sonnet-5
